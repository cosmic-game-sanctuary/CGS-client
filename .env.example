# Copy to .env.local and fill in. Never commit a real .env.

# Origin that serves uploaded game builds. It MUST be a different origin from
# the app, or an uploaded game can reach the page that embeds it. Point it at a
# subdomain serving this same dist/ (index.html, preview-host.html,
# preview-sw.js), the way itch.io uses html-classic.itch.zone.
#
#   VITE_PREVIEW_ORIGIN=https://builds.cosmicgamesanctuary.xyz
#
# Leave it unset in dev: localhost, 127.0.0.1 and [::1] are three origins on one
# machine, and the app probes for whichever of them the dev server is actually
# listening on. Set it here and an origin that doesn't answer is a hard failure,
# which is what you want in a deployment and not on a laptop.
VITE_PREVIEW_ORIGIN=

# Base URL of CGS-server. Defaults to http://localhost:3000 when unset, which
# is what `npm run dev` on the server side listens on.
VITE_API_URL=http://localhost:3000

# Privy app id. Must be the SAME app the server verifies tokens against, or
# every authenticated request 401s — copy PRIVY_APP_ID out of CGS-server/.env.
# It's a public identifier, not a secret. The app shows a setup screen with
# these instructions when it's missing rather than failing obscurely.
VITE_PRIVY_APP_ID=
